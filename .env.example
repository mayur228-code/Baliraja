# ==============================================================================
# Baliraja Krishi Seva Kendra — Production & Environment Configuration
# ==============================================================================

# Application URL (Used for constructing password reset links and CORS validation)
# Local: http://localhost:5173 | Production: https://your-domain.vercel.app or https://baliraja.in
APP_URL=http://localhost:5173
VITE_APP_URL=http://localhost:5173

# Server Port (for local standalone server)
PORT=3001

# ==============================================================================
# Supabase Configuration (Database & Storage)
# ==============================================================================
# Server-side environment variables (for Express / Vercel Serverless runtime)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=baliraja-assets

# Client-side environment variables (for browser / Vite frontend build)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ==============================================================================
# SMTP Email Provider Configuration (Nodemailer for Admin Password Reset)
# ==============================================================================
# Examples:
# For Brevo (Sendinblue): SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER=xxx, SMTP_PASS=xxx
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your-email@gmail.com, SMTP_PASS=your-app-password
# For Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=resend, SMTP_PASS=re_xxxxxxx

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Baliraja Krishi Seva Kendra" <no-reply@baliraja.in>

# ==============================================================================
# Security, CORS & Initial Admin Provisioning (Optional)
# ==============================================================================
# ALLOWED_ORIGINS=https://baliraja.in,https://admin.baliraja.in
# TRUST_PROXY=true
# COOKIE_SECURE=true
# INITIAL_ADMIN_EMAIL=balirajaksk.kaij@gmail.com
# INITIAL_ADMIN_PASSWORD=your_initial_12+_char_password
